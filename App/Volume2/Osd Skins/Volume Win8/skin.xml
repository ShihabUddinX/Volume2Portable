<?xml version="1.0" encoding="utf-8"?>
<XMLskinSettings>
  <Info>
    <Author>Alexandr Irza</Author>
    <WebSite>http://volume2.googlecode.com/</WebSite>
    <SkinVersion>3.0</SkinVersion>
  </Info>
  <OSD>
    <!--Orientation: BitMoveUp, BitMoveRight, BitStripBottom, BitStripRight, Horizontal, Vertical-->
    <!--LayerIndex: -1 - plNone, 0 - plAfterBack, 1 - plAfterAnimation, 2 - plAfterMeter, 3 - plAfterText, 4 - plAfterDigits, 5 - plAfterGlass-->
    <!--Color: #AARRGGBB-->
    <!--Alignment: 0 - taLeft, 1 - taCenter, 2 - taRight-->
    <FadeSteps>24</FadeSteps>
    <ShowSteps>24</ShowSteps>
    <Colorization>false</Colorization>
    <!--Value format: #AARRGGBB. -1 - Use system color-->
    <ColorizationColor>-3752175</ColorizationColor>
    <Background Colorize="true"/>
    <Meter X="76" Y="25" Orientation="HORIZONTAL" Min="0" Max="88" HideOnMute="false" Colorize="true"/>
    <MeterMute X="76" Y="25" Orientation="HORIZONTAL" Min="0" Max="88" Colorize="true"/>
    <MeterEffect Enable="true" Orientation="BITSTRIPBOTTOM" Min="0" Max="3" LayerIndex="2" HideOnMute="true" X="21" Y="13" Colorize="false" FileName=""/>
    <MeterMuteEffect Enable="false" LayerIndex="0" X="0" Y="0" Colorize="true"/>
    <PeakMeter Enable="true" LayerIndex="1" Colorize="false" Style="STEREO" Orientation="HORIZONTAL" Max="22">
      <LeftChannel X="76" Y="23" Inverse="false"/>
      <RightChannel X="76" Y="36" Inverse="false"/>
    </PeakMeter>
    <Text Enable="false" X="0" Y="0" Format="%d%%" FormatMute="%d%%" Alignment="1" HideOnMute="true" LayerIndex="-1">
      <Font Size="0" Color="#FFFFFFFF" ColorMute="#FFFFFFFF" Name="Tahoma" Bold="false" Italic="false"/>
    </Text>
    <NotificationText Enable="false" X="0" Y="0" Width="0" Height="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </NotificationText>
    <CDDriveLetter Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </CDDriveLetter>
    <USBDriveLetter Enable="true" X="10" Y="42" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </USBDriveLetter>
    <USBFriendlyName Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </USBFriendlyName>
  </OSD>
  <Layers/>
</XMLskinSettings>
