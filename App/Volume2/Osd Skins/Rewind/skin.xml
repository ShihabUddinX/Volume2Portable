<?xml version="1.0" encoding="utf-8"?>
<XMLskinSettings>
  <Info>
    <Author>Alex Becherer</Author>
    <WebSite>http://my.opera.com/moshi</WebSite>
    <SkinVersion>3.0</SkinVersion>
  </Info>
  <OSD>
    <!--Orientation: BitMoveUp, BitMoveRight, BitStripBottom, BitStripRight, Horizontal, Vertical-->
    <!--LayerIndex: -1 - plNone, 0 - plAfterBack, 1 - plAfterAnimation, 2 - plAfterMeter, 3 - plAfterText, 4 - plAfterDigits, 5 - plAfterGlass-->
    <!--Color: #AARRGGBB-->
    <!--Alignment: 0 - taLeft, 1 - taCenter, 2 - taRight-->
    <FadeSteps>34</FadeSteps>
    <ShowSteps>33</ShowSteps>
    <Colorization>false</Colorization>
    <!--Value format: #AARRGGBB. -1 - Use system color-->
    <ColorizationColor>-1</ColorizationColor>
    <Background Colorize="true"/>
    <Meter X="60" Y="28" Orientation="BITSTRIPBOTTOM" Min="0" Max="22" HideOnMute="false" Colorize="true"/>
    <MeterMute X="60" Y="28" Orientation="BITSTRIPBOTTOM" Min="0" Max="22" Colorize="true"/>
    <MeterEffect Enable="false" Orientation="HORIZONTAL" Min="0" Max="0" LayerIndex="0" HideOnMute="false" X="0" Y="0" Colorize="false" FileName=""/>
    <MeterMuteEffect Enable="false" LayerIndex="0" X="0" Y="0" Colorize="true"/>
    <PeakMeter Enable="false" LayerIndex="-1" Colorize="false" Style="MONO" Orientation="HORIZONTAL" Max="-1">
      <LeftChannel X="0" Y="0" Inverse="false"/>
      <RightChannel X="0" Y="0" Inverse="false"/>
    </PeakMeter>
    <Text Enable="false" X="0" Y="0" Format="%d%%" FormatMute="%d%%" Alignment="1" HideOnMute="true" LayerIndex="-1">
      <Font Size="0" Color="#FFFFFFFF" ColorMute="#FFFFFFFF" Name="Tahoma" Bold="false" Italic="false"/>
    </Text>
    <NotificationText Enable="false" X="0" Y="0" Width="0" Height="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </NotificationText>
    <CDDriveLetter Enable="true" X="137" Y="32" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </CDDriveLetter>
    <USBDriveLetter Enable="true" X="99" Y="25" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </USBDriveLetter>
    <USBFriendlyName Enable="false" X="0" Y="0" Alignment="0" LayerIndex="-1">
      <Font Size="16" Color="#FF000000" Name="Tahoma" Bold="false" Italic="false"/>
    </USBFriendlyName>
  </OSD>
  <Layers/>
</XMLskinSettings>
